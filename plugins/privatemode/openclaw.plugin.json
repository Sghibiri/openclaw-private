{
  "id": "privatemode",
  "categories": ["models"],
  "activation": {
    "onStartup": true
  },
  "enabledByDefault": true,
  "providers": ["privatemode"],
  "providerAuthChoices": [
    {
      "provider": "privatemode",
      "method": "api-key",
      "choiceId": "privatemode-api-key",
      "appGuidedSecret": true,
      "choiceLabel": "Privatemode API key",
      "groupId": "privatemode",
      "groupLabel": "Privatemode",
      "groupHint": "Attested confidential-compute enclaves, Edgeless Systems (Germany)",
      "optionKey": "privatemodeApiKey",
      "cliFlag": "--privatemode-api-key",
      "cliOption": "--privatemode-api-key <key>",
      "cliDescription": "Privatemode API key"
    }
  ],
  "configGroups": [
    {
      "id": "attestation",
      "title": "Attestation",
      "order": 10,
      "properties": ["attestation"]
    },
    {
      "id": "relay",
      "title": "Relay",
      "order": 20,
      "properties": ["relay"]
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "attestation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxAgeMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "description": "Re-verify the deployment after this many minutes. Default 15."
          },
          "manifestPin": {
            "type": "string",
            "enum": ["auto", "strict"],
            "description": "auto: record vendor manifest rotations in the audit log and continue. strict: refuse to send when the verified manifest differs from the pinned one under <stateDir>/privatemode/manifest.json."
          }
        }
      },
      "relay": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535,
            "description": "Loopback port of the attested relay. Default 19932. If you change it, set models.providers.privatemode.baseUrl to http://127.0.0.1:<port>/v1."
          }
        }
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "privatemode",
        "authMethods": ["api-key"],
        "envVars": ["PRIVATEMODE_API_KEY"]
      }
    ]
  },
  "modelCatalog": {
    "providers": {
      "privatemode": {
        "baseUrl": "http://127.0.0.1:19932/v1",
        "api": "openai-completions",
        "defaultModel": "gpt-oss-120b",
        "models": [
          {
            "id": "gpt-oss-120b",
            "name": "gpt-oss-120b (Privatemode enclave)",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 32768,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            }
          }
        ]
      }
    }
  }
}
