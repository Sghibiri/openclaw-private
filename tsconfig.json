{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["plugins/**/*.ts", "shared/**/*.ts", "test/**/*.ts", "types/**/*.d.ts", "vitest.config.ts"]
}
